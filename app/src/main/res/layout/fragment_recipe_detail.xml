<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme_background"
    tools:context=".RecipeDetailFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/creme_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/creme_background"
            app:menu="@menu/menu_recipe_detail"
            app:title="@string/recipe_detail_label"
            app:titleTextColor="@color/text_dark" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Recipe Title at Top -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_recipe_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sample_recipe_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/green_primary_dark"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Recipe Image Container with Overlays -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image_container"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_recipe_title">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Recipe Picture -->
                    <ImageView
                        android:id="@+id/iv_recipe_picture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/sample_recipe_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/recipe_sample_image" />

                    <!-- Interactive 5 Stars Rating Overlay -->
                    <LinearLayout
                        android:id="@+id/layout_rating_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/ic_launcher_background"
                        android:backgroundTint="#B3000000"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:id="@+id/iv_star_1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:clickable="true"
                            android:contentDescription="@string/cd_star_rating"
                            android:focusable="true"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/iv_star_2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:clickable="true"
                            android:contentDescription="@string/cd_star_rating"
                            android:focusable="true"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/iv_star_3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:clickable="true"
                            android:contentDescription="@string/cd_star_rating"
                            android:focusable="true"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/iv_star_4"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:clickable="true"
                            android:contentDescription="@string/cd_star_rating"
                            android:focusable="true"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/iv_star_5"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:clickable="true"
                            android:contentDescription="@string/cd_star_rating"
                            android:focusable="true"
                            android:src="@drawable/ic_star" />

                        <TextView
                            android:id="@+id/tv_star_rating_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/rating_5_0"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Favorite Button Overlay (Heart) -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:contentDescription="@string/cd_favorite"
                        android:src="@drawable/ic_favorite"
                        app:backgroundTint="@color/creme_background"
                        app:fabCustomSize="44dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:tint="@color/favorite_red" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Key Information Section (Category, Cooking Time, Portions) -->
            <LinearLayout
                android:id="@+id/layout_key_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_image_container">

                <!-- Category Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/green_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/green_tint"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/category_label"
                            android:src="@drawable/ic_category"
                            app:tint="@color/green_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/category_label"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/text_medium" />

                        <TextView
                            android:id="@+id/tv_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sample_category"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cooking Time Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/green_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/green_tint"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/time_label"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/green_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/time_label"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/text_medium" />

                        <TextView
                            android:id="@+id/tv_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sample_time"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Portions Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/green_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/green_tint"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/portions_label"
                            android:src="@drawable/ic_servings"
                            app:tint="@color/green_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/portions_label"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/text_medium" />

                        <TextView
                            android:id="@+id/tv_portions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sample_portions"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Ingredients Section -->
            <TextView
                android:id="@+id/tv_ingredients_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ingredients_heading"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/green_primary_dark"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_key_info" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ingredients"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/creme_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_ingredients_heading">

                <LinearLayout
                    android:id="@+id/layout_ingredients_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_ingredients_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/text_dark"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Instructions Section -->
            <TextView
                android:id="@+id/tv_instructions_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/instructions_heading"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/green_primary_dark"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_ingredients" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_instructions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/creme_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_instructions_heading">

                <LinearLayout
                    android:id="@+id/layout_instructions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_instructions_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/text_dark"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Source Link Section -->
            <TextView
                android:id="@+id/tv_source_link_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_source_link"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/green_primary_dark"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_instructions" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_source_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/creme_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_source_link_heading">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_source_link_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoLink="web"
                        android:linksClickable="true"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/green_primary"
                        android:textStyle="bold|italic" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Raw Scraped Text Section -->
            <TextView
                android:id="@+id/tv_scraped_text_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_scraped_text"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/green_primary_dark"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_source_link" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scraped_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/creme_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_scraped_text_heading">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_scraped_text_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/text_dark" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>