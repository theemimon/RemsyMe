<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme_background"
    tools:context=".CategoryRecipesFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/creme_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/creme_background"
            app:title="@string/cat_pasta"
            app:titleTextColor="@color/green_primary_dark" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="90dp">

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/category_recipes_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/text_medium" />

            <!-- Empty State Message -->
            <TextView
                android:id="@+id/tv_empty_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/empty_category_msg"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/text_medium"
                android:visibility="gone" />

            <!-- DYNAMIC 2-COLUMN RECIPES GRID -->
            <GridLayout
                android:id="@+id/grid_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:useDefaultMargins="true" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Bulk Selection Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bulk_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/creme_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/green_tint"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Selection Count Label -->
            <TextView
                android:id="@+id/tv_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/selection_count_fmt"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/green_primary_dark"
                android:textStyle="bold" />

            <!-- Move Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bulk_move"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_bulk_move"
                android:textColor="@color/green_primary"
                app:strokeColor="@color/green_primary" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bulk_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_bulk_delete"
                app:backgroundTint="@color/favorite_red"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/white" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>