<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Step Label (e.g. "Step 1") -->
    <TextView
        android:id="@+id/tv_step_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:minWidth="52dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/green_primary_dark"
        android:textStyle="bold" />

    <!-- Instruction Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_step_instruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:hint="@string/hint_step_instruction"
        app:boxBackgroundColor="@color/creme_card"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/green_primary"
        app:hintTextColor="@color/green_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_step_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="@color/text_dark" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Remove / Delete Button -->
    <ImageButton
        android:id="@+id/btn_remove_step"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_remove_step"
        android:src="@drawable/ic_delete"
        app:tint="@color/favorite_red" />

</LinearLayout>
