    <string name="ingredients_heading">Ingredients</string>
    <string name="ingredient_1">• 200g Fettuccine or Spaghetti</string>
    <string name="ingredient_2">• 2 ripe Avocados, pitted</string>
    <string name="ingredient_3">• 2 cloves Garlic, minced</string>
    <string name="ingredient_4">• &#189; cup Fresh Basil leaves</string>
    <string name="ingredient_5">• 2 tbsp Extra Virgin Olive Oil</string>
    <string name="ingredient_6">• 1 tbsp Fresh Lemon Juice</string>
    <string name="ingredient_7">• &#8531; cup Grated Parmesan cheese</string>
    <string name="ingredient_8">• Salt and freshly ground Black Pepper to taste</string>

    <string name="instructions_heading">Instructions</string>
    <string name="step_1">1. Cook pasta in a large pot of boiling salted water according to package instructions until al dente.</string>
    <string name="step_2">2. In a food processor or blender, combine avocados, garlic, basil, olive oil, and lemon juice. Blend until smooth and creamy.</string>
    <string name="step_3">3. Drain cooked pasta, reserving &#188; cup of pasta water.</string>
    <string name="step_4">4. Toss hot pasta with avocado cream sauce, adding reserved water if needed. Season with salt, pepper, and parmesan.</string>
    <string name="step_5">5. Garnish with fresh basil leaves and extra parmesan cheese before serving warm.</string>

